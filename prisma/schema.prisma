generator client { 
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String
  createdAt      DateTime       @default(now())
  role           Role           @default(USER)
  favorites      Favorite[]
  feedbacks      Feedback[]
  mylist         MyList[]
  ratings        Rating[]
  watchHistories WatchHistory[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
}

model MyList {
  id        String       @id @default(uuid())
  userId    String
  movieId   Int
  status    MyListStatus @default(TOWATCH)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  value     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  movieId   Int
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int?
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum MyListStatus {
  TOWATCH
  WATCHING
  COMPLETED
}

enum Role {
  USER
  ADMIN
}
