generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int            @id @default(autoincrement())
  name           String
  email          String         @unique
  password       String
  createdAt      DateTime       @default(now())
  watchHistories WatchHistory[] // ← back-relation
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  genre       String
  year        Int
  createdAt   DateTime @default(now())

  watchHistories WatchHistory[] // ← back-relation added here
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  watchedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])
}
