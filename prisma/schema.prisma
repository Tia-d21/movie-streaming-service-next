generator client { 
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now())
  role         Role           @default(USER)
  favorites    Favorite[]
  feedbacks    Feedback[]
  mylist       MyList[]
  ratings      Rating[]
  watchHistory WatchHistory[]
}

model Movie {
  id           Int            @id
  title        String
  description  String
  genre        String
  year         Int
  url          String
  createdAt    DateTime       @default(now())
  rating       Float?
  releaseDate  DateTime?
  posterPath   String?
  favorites    Favorite[]
  feedbacks    Feedback[]
  mylist       MyList[]
  ratings      Rating[]
  watchHistory WatchHistory[]
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  movieId   Int
  watchedAt DateTime @default(now())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model MyList {
  id        String       @id @default(uuid())
  userId    String
  movieId   Int
  status    MyListStatus @default(TOWATCH)
  createdAt DateTime     @default(now())
  movie     Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  value     Int
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  movieId   Int
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int?
  message   String
  createdAt DateTime @default(now())
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MyListStatus {
  TOWATCH
  WATCHING
  COMPLETED
}

enum Role {
  USER
  ADMIN
}
