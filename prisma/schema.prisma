generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Relations
  favorites    Favorite[]
  mylist       MyList[]
  ratings      Rating[]
  feedbacks    Feedback[]
  watchHistory WatchHistory[] // Corrected pluralization from watchHistories
}

model Movie {
  // --- CHANGE 1: Use the TMDB ID as the primary key. It's already unique. ---
  id          Int      @id
  title       String
  description String
  genre       String
  categoryId  String?
  year        Int
  releaseDate DateTime?
  url         String
  rating      Float?
  createdAt   DateTime @default(now())

  // --- CHANGE 2: Add the missing posterPath field. ---
  posterPath  String? // This will store the image URL.

  // Relations
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites    Favorite[]
  mylist       MyList[]
  ratings      Rating[]
  feedbacks    Feedback[]
  watchHistory WatchHistory[] // Corrected pluralization from watchHistories
}

model Category {
  id     String  @id @default(cuid())
  name   String  @unique
  movies Movie[]
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  movieId   Int
  watchedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade) // Added onDelete
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade) // Added onDelete

  @@unique([userId, movieId])
}

model MyList {
  id        String       @id @default(uuid())
  userId    String
  movieId   Int
  status    MyListStatus @default(TOWATCH)
  createdAt DateTime     @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade) // Added onDelete
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade) // Added onDelete

  @@unique([userId, movieId])
}

enum MyListStatus {
  TOWATCH
  WATCHING
  COMPLETED
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  value     Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade) // Added onDelete
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade) // Added onDelete

  @@unique([userId, movieId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int?
  message   String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Added onDelete
  movie Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade) // Added onDelete
}

enum Role {
  USER
  ADMIN
}